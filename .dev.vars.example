# Dashboard (http://localhost:8788/dash/): localhost skips the Access check.
# Leave empty to see the empty dashboard; to see real data locally, run the
# proxy too (`wrangler dev -c wrangler.mcp.jsonc -c wrangler.proxy.jsonc`)
# with a key that's in its PROXY_KEYS.
DASH_PROXY_KEY=""

# Cloudflare account setup (`pnpm setup:cloudflare`), read by the setup script
# only, never by the Worker. Use the account's Global API Key (My Profile ->
# API Tokens -> Global API Key) and the login email.
CF_EMAIL=""
CF_GLOBAL_API_KEY=""
