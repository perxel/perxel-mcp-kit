{
  "name": "perxel-mcp-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "echo '' && echo '  MCP        -> http://localhost:8788/mcp' && echo '  Dashboard  -> http://localhost:8788/dash/' && echo '  Inspector  -> http://localhost:8002' && echo '' && (CLIENT_PORT=8002 pnpm exec @modelcontextprotocol/inspector --transport http --server-url http://localhost:8788/mcp &) && wrangler dev -c wrangler.mcp.jsonc --port 8788",
    "typecheck": "tsc",
    "test": "vitest run",
    "eval": "tsx kit/testing/eval.ts",
    "inspect": "tsx kit/testing/inspect.ts",
    "kit:update": "tsx kit/update/update.ts",
    "setup:cloudflare": "tsx kit/setup/setup.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.166",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@modelcontextprotocol/inspector": "2.14.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  }
}
