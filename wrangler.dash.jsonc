{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "example-dash",
  "main": "kit/dashboard/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // Client slug: served at https://dash.perxel.com/<slug>/ (needs a Worker
    // route for dash.perxel.com/<slug>/* plus a Cloudflare Access rule for
    // /<slug> — deployment-time steps for the README, not this file).
    "SLUG": "example",
    // This client's metrics-proxy URL (the Worker from wrangler.proxy.jsonc).
    "PROXY_URL": "<paste: metrics proxy URL>"
  },
  // Secrets (never commit values; set with `wrangler secret put -c wrangler.dash.jsonc <name>`):
  //   PROXY_KEY: this dashboard's key (the proxy maps its SHA-256 to the
  //     client's dataset; Grafana sends it as an Authorization header).
  "durable_objects": {
    "bindings": [{ "name": "GRAFANA", "class_name": "Grafana" }]
  },
  "exports": {
    "Grafana": { "type": "durable-object", "storage": "sqlite" }
  },
  "containers": [
    {
      "class_name": "Grafana",
      "image": "./kit/dashboard/Dockerfile",
      // Repo root, so the Dockerfile can COPY both kit/dashboard/... and the
      // clone's own dashboards/... extras into the image.
      "image_build_context": ".",
      // Stamps the client's dataset (mcp_<slug>) into the base dashboard at
      // build time; the clone owns this file so kit/ stays untouched.
      "image_vars": { "DATASET": "mcp_example" },
      // Smallest size that fits Grafana; raise after the memory/cold-start
      // check (unverified: no Docker on the build machine, see 001-notes.md).
      "instance_type": "basic",
      "max_instances": 1
    }
  ]
}
